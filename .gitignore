# Raw, full-resolution source files -- too large for git (GitHub's
# hard limit is 100MB/file) and not needed once a compressed web
# version has been generated from them.
originals/

# Staged media not yet approved/resized for actual use on the site --
# kept locally for review, never committed.
pending/

# Word's own lock/temp files, created while a .docx is open.
~$*
~WRL*.tmp
